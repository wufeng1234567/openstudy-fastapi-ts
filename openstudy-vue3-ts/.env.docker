# ============================================================
# 前端容器构建专用环境（Docker）
# ------------------------------------------------------------
# 关键：VITE_APP_BASE_API 用**相对路径** '/'。
#   容器里前端由 Nginx 托管，同一个 Nginx 把 /ai、/dev-api、
#   /profile、/system 等前缀反代到后端容器。
#   这样浏览器只需访问 http://localhost:8080 一个地址，
#   换 IP / 换端口 / 换机器都不用改前端构建。
#
# 之所以不用 .env.production 里写死的 http://localhost:9101：
#   那要求浏览器能直连后端端口，容器化后没必要且易错。
# ============================================================
VITE_APP_TITLE = OpenStudy
VITE_APP_ENV = 'production'
VITE_APP_BASE_API = '/'
VITE_APP_BASE_URL = ''
VITE_WS_URL = ''
VITE_BUILD_COMPRESS = gzip
