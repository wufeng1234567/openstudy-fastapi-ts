# ============================================================
# OpenStudy 后端环境变量样例
# ------------------------------------------------------------
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，禁止提交真实密钥。
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=9101
DEBUG=True

# ---------- 数据库 ----------
# DB_DRIVER=postgres 走 PostgreSQL + pgvector 主线；改成 mysql 可回滚 MySQL
DB_DRIVER=postgres

# MySQL（DB_DRIVER=mysql 时使用）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=openstudy
DB_USER=root
DB_PASSWORD=

# PostgreSQL（DB_DRIVER=postgres 时使用，需安装 pgvector 扩展）
PG_HOST=localhost
PG_PORT=5432
PG_NAME=openstudy
PG_USER=root
PG_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 安全 ----------
# 生产环境务必替换为随机长字符串
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ---------- 上传 ----------
# 默认指向项目内 data/uploadPath；如需外置可改为绝对路径
# UPLOAD_DIR=D:/openstudy/uploadPath
MAX_FILE_SIZE=10485760

# ---------- CORS ----------
# 逗号分隔；留空使用代码内默认值
CORS_ORIGINS=

# ---------- AI 模型 ----------
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-flash
AI_DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3

# ---------- AI 限流总开关（本地 vs 线上）----------
# true（默认，线上体验版）：按 Redis 配置限流，防刷 + 控 API 成本
# false（本地开发版）：中间件直接放行，连计数器都不写
# ⚠️ 这是**最高优先级**硬开关，压过后台「限流监控」页里的 Redis 配置。
#    本地启动脚本 startup-scripts/start-fastapi.bat 已自动设 false，
#    线上 daily-start.sh 显式设 true —— 一般不需要手动改这里。
AI_RATE_LIMIT_ENABLED=true

# RAG 向量化后端：auto（默认，优先本地模型，不可用再走硅基流动）/ local（纯本地，不需 Key）/ siliconflow（云端，需下面的 Key）
# 本地模型优先从**魔搭(ModelScope)**下载（国内直连，绕开 huggingface.co 被墙）
EMBEDDING_BACKEND=auto
# 本地模型缓存/下载目录（留空=默认；首次会自动下载模型 BAAI/bge-m3 约 2.2GB）
EMBEDDING_MODEL_DIR=

# DeepSeek 官方 API
DEEPSEEK_API_KEY=

# 智谱
ZHIPU_API_KEY=

# 硅基流动（仅当 EMBEDDING_BACKEND=siliconflow 或 auto 回退到云端时需要）
SILICONFLOW_API_KEY=

# ---------- DeepSeek 网页端反代 ds-free（可选）----------
# 用于「不开浏览器直接聊天」的反代链路，涉及账号凭据，请谨慎配置。
DEEPSEEK_WEB_ENABLED=false
DEEPSEEK_WEB_PHONE=
DEEPSEEK_WEB_PASSWORD=
DEEPSEEK_WEB_AREA_CODE=+86
# 会话导入材料（浏览器 localStorage / cookie 抄出，约 24 小时有效）
DEEPSEEK_WEB_TOKEN=
DEEPSEEK_WEB_COOKIE=
DEEPSEEK_WEB_HIF_DLIQ=
DEEPSEEK_WEB_HIF_LEIM=
DEEPSEEK_WEB_DEVICE_ID=
