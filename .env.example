# ============================================================
# OpenStudy 一键部署配置（Docker Compose 读取）
# ------------------------------------------------------------
# 用法：复制本文件为 .env，按需修改后再执行 docker compose up -d --build
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，禁止提交真实密钥。
# ============================================================

# ---------- 数据库（容器内部使用，无需改动即可跑）----------
PG_NAME=openstudy_v2_pgsql
PG_USER=root
PG_PASSWORD=123456

# ---------- 安全：生产/公开访问务必改成长随机串 ----------
JWT_SECRET=openstudy-change-me-in-production

# ---------- AI 模型 Key（不填 AI 对话/知识库不可用，其余功能正常）----------
# DeepSeek 官方（对话/生成）
DEEPSEEK_API_KEY=
# 硅基流动（RAG 知识库向量化，模型 BAAI/bge-m3）
SILICONFLOW_API_KEY=
# 智谱（可选）
ZHIPU_API_KEY=
